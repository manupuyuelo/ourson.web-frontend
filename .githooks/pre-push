#!/bin/sh
# Ourson web — la même porte que la CI (`yarn verify` : types, lint, format, tests), jouée
# avant que le push parte. Contournable par `git push --no-verify` quand on sait ce qu'on fait.
set -e

# Une suppression de branche (sha local à zéro) ne contient aucun code à vérifier.
ZERO=0000000000000000000000000000000000000000
a_du_code=0
while read -r _ sha_local _ _; do
  case "$sha_local" in
    "" | "$ZERO") continue ;;
  esac
  a_du_code=1
done
if [ "$a_du_code" -eq 0 ]; then
  exit 0
fi

# Clients git graphiques : PATH minimal sans nvm ni Homebrew. On laisse passer plutôt que
# d'échouer sur un « command not found » ; la CI reste la vraie porte.
if ! command -v yarn >/dev/null 2>&1; then
  echo "pre-push : yarn introuvable dans ce PATH, porte locale ignorée (la CI vérifiera)."
  exit 0
fi

echo "→ yarn verify (pre-push) — « git push --no-verify » pour passer outre"
yarn verify
